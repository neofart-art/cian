PUBLIC_URL=https://xata.neofart.ru
BIND_IP=172.31.1.1
APP_PORT=3010
# First-run admin bootstrap only; later users/passwords live in SQLite.
APP_USER=owner
# Bootstrap password >=16 chars. Keep existing value: browser API may use it as fallback.
APP_PASSWORD=

# No Cian username/password here. Login is manual in the persistent browser.
# Optional separate internal API secret (>=16 chars); empty uses APP_PASSWORD.
BROWSER_API_TOKEN=
# Enable after manual login and one successful search.
BROWSER_SCHEDULE_ENABLED=false
# Minimum 1800 seconds (30 min); lower values are clamped to 1800.
BROWSER_SEARCH_INTERVAL_SECONDS=1800
# Optional saved-search/ordinary search HTTPS URL on cian.ru.
# Empty: build a search URL from UI filters. UI budget also filters saved-search results.
CIAN_SEARCH_URL=
